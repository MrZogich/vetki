<% layout('./layout/page.ejs') %>
<section class="hero container">
  <span class="pill">ECMAScript · Node.js · браузер</span>
  <h1>Язык, который <span>оживляет</span> веб</h1>
  <p>От простых скриптов до полноценных приложений. Три темы, с которых стоит начать знакомство с JavaScript.</p>
</section>
<section class="container pb-5">
  <div class="row g-4">
    <% topics.forEach(function(t, i) { %>
    <div class="col-md-6 col-lg-4">
      <a class="topic-card" href="/topics/<%= t.nick %>">
        <img src="<%= t.avatar %>" alt="<%= t.title %>">
        <div class="topic-card-body">
          <span class="num">0<%= i + 1 %></span>
          <h3><%= t.title %></h3>
          <p><%= t.desc %></p>
          <span class="more">Открыть тему →</span>
        </div>
      </a>
    </div>
    <% }); %>
  </div>
</section>
